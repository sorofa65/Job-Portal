---
import Layout from '../layouts/Layout.astro';
import FlipBoard from '../components/FlipBoard.astro';
import FilterBar from '../components/FilterBar.astro';
import JobCard from '../components/JobCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getAllPosts, getUrgentPosts } from '../utils/jobs.js';

const allPosts = getAllPosts();
const urgentPosts = getUrgentPosts();
const PAGE_SIZE = 6;
const firstPage = allPosts.slice(0, PAGE_SIZE);
const remaining = allPosts.slice(PAGE_SIZE);
---

<Layout
  title="চাকরির খবর ২০২৬ | Job Circular 2026 Bangladesh | সরকারি ও বেসরকারি চাকরি"
  description="চাকরির খবর ২০২৬ ও Job Circular 2026 Bangladesh-এর সর্বশেষ আপডেট দেখুন। সরকারি চাকরি, বেসরকারি চাকরি, ব্যাংক চাকরি, NGO Job, নিয়োগ বিজ্ঞপ্তি, আবেদন পদ্ধতি, যোগ্যতা ও আবেদনের শেষ তারিখ এক জায়গায়।"
>

  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:items-start">
      <div class="lg:col-span-3">
        <span class="pill !cursor-default border-brand-400/40 text-brand-600 dark:text-brand-300">
          Updated {new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}
        </span>
        <h1 class="mt-4 text-balance font-display text-4xl font-bold leading-[1.1] text-ink dark:text-paper sm:text-5xl">
          Every job circular that matters, <span class="text-brand-500">the moment it's published.</span>
        </h1>
        <p class="mt-4 max-w-xl text-ink-muted dark:text-paper/50">
          Government, bank, and private-sector notices — organized, deadline-tracked, and searchable in seconds. No clutter, no guesswork.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#job-grid" class="btn-primary">Browse latest posts</a>
          <a href="/category/govt-job/" class="btn-outline">Govt jobs only</a>
        </div>
      </div>

      <div class="lg:col-span-2">
        <FlipBoard posts={urgentPosts.length ? urgentPosts : allPosts} />
      </div>
    </div>
  </section>

  <!-- Filters -->
  <section class="mx-auto mt-10 max-w-7xl px-4 sm:px-6 lg:px-8">
    <FilterBar />
  </section>

  <!-- Grid -->
  <section id="job-grid" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div id="post-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {firstPage.map((post) => <JobCard post={post} />)}
    </div>

    {allPosts.length === 0 && (
      <div class="rounded-xl2 border border-dashed border-brand-300 bg-brand-500/5 px-6 py-14 text-center dark:border-brand-700">
        <h2 class="font-display text-xl font-semibold text-ink dark:text-paper">New circulars are being prepared.</h2>
        <p class="mt-2 text-sm text-ink-muted dark:text-paper/60">Please check back soon for verified Bangladesh job notices.</p>
      </div>
    )}

    <AdSlot variant="in-content" slotId="home-mid" />

    <div id="more-posts" class="hidden grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {remaining.map((post) => <JobCard post={post} />)}
    </div>

    {remaining.length > 0 && (
      <div class="mt-8 flex justify-center">
        <button id="load-more" class="btn-outline">
          Load {remaining.length} more posts
        </button>
      </div>
    )}
  </section>
</Layout>

<script>
  const loadMoreBtn = document.getElementById('load-more');
  const morePosts = document.getElementById('more-posts');
  loadMoreBtn?.addEventListener('click', () => {
    morePosts?.classList.remove('hidden');
    morePosts?.classList.add('grid');
    loadMoreBtn.remove();
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import blog from '../../data/blog.json';

const posts = [...blog].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---
<Layout title="Career & Exam Blog — Yakub Blog" description="Practical Bangladesh career, job application, and government exam preparation guidance.">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="pill !cursor-default border-brand-400/40 text-brand-600 dark:text-brand-300">Career desk</p>
    <h1 class="mt-4 font-display text-4xl font-bold text-ink dark:text-paper">Useful guidance for the next application.</h1>
    <p class="mt-3 max-w-2xl text-ink-muted dark:text-paper/60">Clear, practical notes on preparing for exams and submitting stronger applications.</p>
    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="job-card overflow-hidden group">
          <img src={post.image} alt={post.title} loading="lazy" class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="p-5"><span class="font-mono text-xs text-brand-600 dark:text-brand-300">{post.category} · {post.readTimeMinutes} min read</span><h2 class="mt-2 font-display text-xl font-semibold text-ink dark:text-paper group-hover:text-brand-600 dark:group-hover:text-brand-300">{post.title}</h2><p class="mt-2 text-sm text-ink-muted dark:text-paper/60">{post.excerpt}</p></div>
        </a>
      ))}
    </div>
    {posts.length === 0 && (
      <div class="mt-8 rounded-xl2 border border-dashed border-brand-300 bg-brand-500/5 px-6 py-14 text-center dark:border-brand-700">
        <h2 class="font-display text-xl font-semibold text-ink dark:text-paper">New articles are coming soon.</h2>
        <p class="mt-2 text-sm text-ink-muted dark:text-paper/60">Practical exam and career guidance will appear here.</p>
      </div>
    )}
    <AdSlot variant="in-content" slotId="blog-mid" />
  </section>
</Layout>

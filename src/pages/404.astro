---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/jobs.js';

const latestPosts = getAllPosts().slice(0, 3);
---

<Layout title="Page Not Found — Yakub Blog" description="The page you requested could not be found on Yakub Blog." robots="noindex, follow" showFloatingAd={false}>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-16 text-center sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-semibold tracking-widest text-urgent-500">404 / NOT FOUND</p>
    <h1 class="mt-4 font-display text-4xl font-bold text-ink dark:text-paper sm:text-5xl">This page has moved on.</h1>
    <p class="mt-4 max-w-xl text-ink-muted dark:text-paper/60">The link may be outdated, or the circular may have been removed. Start from the latest verified listings.</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Browse latest jobs</a>
      <a href="/blog/" class="btn-outline">Read the career blog</a>
    </div>
    {latestPosts.length > 0 && (
      <div class="mt-12 w-full text-left">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">Latest available posts</h2>
        <ul class="mt-3 divide-y divide-ink/10 rounded-lg border border-ink/10 dark:divide-paper/10 dark:border-paper/10">
          {latestPosts.map((post) => (
            <li><a href={`/posts/${post.slug}/`} class="block px-4 py-3 text-sm text-brand-600 hover:bg-brand-500/5 dark:text-brand-300">{post.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>
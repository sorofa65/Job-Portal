---
import Layout from '../../layouts/Layout.astro';
import DeadlineBadge from '../../components/DeadlineBadge.astro';
import AdSlot from '../../components/AdSlot.astro';
import JobCard from '../../components/JobCard.astro';
import { getPostBySlug, getAllPosts, formatDate, getDeadline } from '../../utils/jobs.js';

export function getStaticPaths() {
  return getAllPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: ReturnType<typeof getAllPosts>[number] };

const postTitle = post.title ?? post.seo?.metaTitle ?? post.seo?.metaTitleEn ?? post.slug ?? 'Job circular';
const org = post.organization?.nameEn ?? post.organization?.nameBn ?? post.summaryTable?.find((r) => /organization|প্রতিষ্ঠানের নাম/i.test(r.label))?.value ?? postTitle;
const deadline = getDeadline(post);
const pageTitle = post.seo?.metaTitle ?? postTitle;
const pageDescription = post.seo?.metaDescription ?? post.metaDescription;
const publishedDate = post.publishedAt ?? post.date;
const coverImage = post.image;
const summaryTable = post.summaryTable ?? [];
const positions = post.positions ?? [];
const noticeImages = (post.noticeImages ?? []).map((notice) => typeof notice === 'string' ? { url: notice, alt: postTitle } : notice);
const applicationSteps = (post.applicationSteps ?? []).map((step) => typeof step === 'string' ? { title: step, detail: '' } : { title: step.titleBn ?? step.titleEn ?? '', detail: step.detailBn ?? step.detailEn ?? '' });
const introContent = String(post.introContent ?? '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');

const related = getAllPosts()
  .filter((p) => p.category === post.category && p.slug !== post.slug)
  .slice(0, 3);

const faqSchema = post.faqs?.length ? [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
}] : [];

const keywords = [post.category, 'Bangladesh job circular', 'job application', org].join(', ');
---

<Layout
  title={`${pageTitle} — BDJobPortal`}
  description={pageDescription ?? `${postTitle} details, eligibility, deadline and application information.`}
  image={coverImage}
  keywords={keywords}
  schemas={faqSchema}
  jobPosting={{
    title: postTitle,
    description: pageDescription ?? postTitle,
    datePosted: publishedDate,
    validThrough: deadline ? deadline.toISOString() : undefined,
    hiringOrganizationName: org,
    applyUrl: post.applyOnlineLink,
  }}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-xs text-ink-muted dark:text-paper/40">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>/</span>
      <a href={`/category/${post.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="hover:text-brand-600">{post.category}</a>
      <span>/</span>
      <span class="truncate text-ink dark:text-paper/70">{postTitle}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      <span class="pill !cursor-default">{post.category}</span>
      <DeadlineBadge post={post} />
    </div>

    <h1 class="mt-3 text-balance font-display text-2xl font-bold leading-tight text-ink dark:text-paper sm:text-3xl">
      {postTitle}
    </h1>

    <div class="mt-3 flex items-center justify-between text-sm text-ink-muted dark:text-paper/50">
      <span class="font-mono">Published {publishedDate && formatDate(publishedDate)}</span>
      <button
        id="bookmark-btn"
        data-post-id={post.id}
        type="button"
        class="flex items-center gap-1.5 rounded-full border border-ink/10 dark:border-paper/15 px-3 py-1.5 text-xs font-medium hover:border-brand-400 transition-colors"
        aria-pressed="false"
      >
        <svg id="bookmark-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21 12 16 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
        <span id="bookmark-label">Save post</span>
      </button>
    </div>

    <div class="mt-6 overflow-hidden rounded-xl2 border border-ink/5 dark:border-paper/10">
      <img src={coverImage} alt={post.imageAlt ?? postTitle} class="aspect-[16/9] w-full object-cover" />
    </div>

    <!-- Key info summary card -->
    <div class="mt-6 glass-card rounded-xl2 p-5 shadow-card">
      <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">Circular Summary</h2>
      <table class="summary-table mt-3 w-full">
        <tbody>
          {summaryTable.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>
                {row.isLink ? (
                  <div class="flex items-center gap-2">
                    <a href={row.url} target="_blank" rel="noopener noreferrer" class="text-brand-600 dark:text-brand-300 hover:underline break-all">
                      {row.value}
                    </a>
                    <button
                      class="copy-link-btn shrink-0 rounded-md border border-ink/10 dark:border-paper/15 px-2 py-0.5 text-[11px] font-mono text-ink-muted hover:border-brand-400"
                      data-copy-value={row.url}
                      type="button"
                    >
                      Copy
                    </button>
                  </div>
                ) : (
                  <span class="font-medium text-ink dark:text-paper">{row.value}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Position & salary table -->
    {(post.positionDetailsTable?.rows?.length > 0 || positions.length > 0) && (
      <div class="mt-8">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">Position &amp; Salary Details</h2>
        <div class="mt-3 overflow-x-auto rounded-lg border border-ink/5 dark:border-paper/10">
          <table class="position-table">
            <thead>
              <tr>
                {(post.positionDetailsTable?.headers ?? ['Post Name', 'Vacancy', 'Educational Qualification', 'Salary Scale']).map((h) => <th>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {(positions.length ? positions.map((position) => [position.nameBn ?? position.nameEn, position.vacancies, position.educationBn ?? position.educationEn, position.payScale]) : post.positionDetailsTable.rows).map((row) => (
                <tr>
                  {row.map((cell) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="prose prose-sm sm:prose-base mt-8 max-w-none prose-headings:font-display prose-headings:text-ink dark:prose-invert prose-a:text-brand-600" set:html={introContent} />

    <!-- Application steps -->
    {applicationSteps.length > 0 && (
      <div class="mt-8">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">How to Apply</h2>
        <ol class="mt-3 space-y-3">
          {applicationSteps.map((step, i) => (
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-xs font-mono font-semibold text-brand-700 dark:text-brand-300">
                {i + 1}
              </span>
              <span class="text-sm text-ink-muted dark:text-paper/60"><strong>{step.title}</strong>{step.detail && ` — ${step.detail}`}</span>
            </li>
          ))}
        </ol>
      </div>
    )}

    {post.organization?.aboutHtml && <div class="prose prose-sm mt-8 max-w-none dark:prose-invert" set:html={post.organization.aboutHtml.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')} />}

    {post.eligibilityMatcher?.rows?.length > 0 && (
      <section class="mt-8"><h2 class="font-display text-lg font-semibold text-ink dark:text-paper">{post.eligibilityMatcher.headingBn ?? 'Eligibility Guide'}</h2><p class="mt-2 text-sm text-ink-muted dark:text-paper/60" set:html={post.eligibilityMatcher.introHtml?.replace(/&lt;/g, '<').replace(/&gt;/g, '>')}></p><div class="mt-3 overflow-x-auto rounded-lg border border-ink/10"><table class="position-table"><thead><tr><th>যোগ্যতা</th><th>যে পদগুলোতে আবেদন করা যাবে</th><th>মোট পদ</th><th>ফি</th></tr></thead><tbody>{post.eligibilityMatcher.rows.map((row) => <tr><td>{row.yourQualification}</td><td>{row.eligiblePosts.join(', ')}</td><td>{row.totalVacancies}</td><td>{row.fee}</td></tr>)}</tbody></table></div></section>
    )}

    {post.salaryBreakdown?.rows?.length > 0 && (
      <section class="mt-8"><h2 class="font-display text-lg font-semibold text-ink dark:text-paper">{post.salaryBreakdown.headingBn ?? 'Salary Breakdown'}</h2><div class="prose prose-sm mt-2 max-w-none dark:prose-invert" set:html={post.salaryBreakdown.introHtml?.replace(/&lt;/g, '<').replace(/&gt;/g, '>')}></div><div class="mt-3 overflow-x-auto rounded-lg border border-ink/10"><table class="position-table"><thead><tr>{post.salaryBreakdown.headers.map((header) => <th>{header}</th>)}</tr></thead><tbody>{post.salaryBreakdown.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
    )}

    {post.faqs?.length > 0 && (
      <section class="mt-8" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-display text-lg font-semibold text-ink dark:text-paper">Frequently Asked Questions</h2>
        <div class="mt-3 space-y-3">
          {post.faqs.map((faq) => (
            <details class="rounded-lg border border-ink/10 bg-white/60 p-4 dark:border-paper/10 dark:bg-white/5">
              <summary class="cursor-pointer pr-5 font-medium text-ink dark:text-paper">{faq.question}</summary>
              <p class="mt-3 text-sm leading-6 text-ink-muted dark:text-paper/60">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <AdSlot variant="in-content" post={post} slotId={`post-${post.id}`} />

    <!-- Notice image gallery -->
    {noticeImages.length > 0 && (
      <div class="mt-8">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">Official Notice</h2>
        <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {noticeImages.map((img, i) => (
            <button
              type="button"
              class="notice-image-trigger overflow-hidden rounded-lg border border-ink/5 dark:border-paper/10"
              data-image={img.url}
              aria-label={`View notice page ${i + 1} full size`}
            >
              <img src={img.url} alt={img.alt ?? `Official notice page ${i + 1}`} loading="lazy" class="aspect-[3/4] w-full object-cover transition-transform duration-300 hover:scale-105" />
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Related posts -->
    {related.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-paper">Related {post.category} Posts</h2>
        <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-3">
          {related.map((p) => <JobCard post={p} />)}
        </div>
      </div>
    )}

    <!-- Spacer so sticky action bar never overlaps content -->
    <div class="h-20"></div>
  </article>

  <!-- Sticky action bar -->
  <div class="fixed inset-x-0 bottom-0 z-30 border-t border-ink/10 bg-white/90 py-3 backdrop-blur-lg dark:border-paper/10 dark:bg-ink-soft/90">
    <div class="mx-auto flex max-w-4xl items-center gap-3 px-4 sm:px-6 lg:px-8">
      {post.pdfNoticeLink && (
        <a href={post.pdfNoticeLink} target="_blank" rel="noopener noreferrer" class="btn-outline flex-1 sm:flex-none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/></svg>
          <span class="hidden sm:inline">Download PDF Notice</span>
          <span class="sm:hidden">PDF</span>
        </a>
      )}
      {post.applyOnlineLink && (
        <a href={post.applyOnlineLink} target="_blank" rel="noopener noreferrer" class="btn-urgent flex-1 justify-center">
          Apply Online Now
        </a>
      )}
    </div>
  </div>

  <!-- Lightbox for notice images -->
  <div id="lightbox" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/85 p-4">
    <button id="lightbox-close" class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white" aria-label="Close image viewer">✕</button>
    <img id="lightbox-img" src="" alt="Official notice full view" class="max-h-[90vh] max-w-full rounded-lg object-contain" />
  </div>
</Layout>

<script>
  // Bookmark / save post — persisted in localStorage keyed by the hidden `id`.
  const KEY = 'bdjp:bookmarks';
  const btn = document.getElementById('bookmark-btn');
  const label = document.getElementById('bookmark-label');
  const postId = btn?.getAttribute('data-post-id');

  function getBookmarks() {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  }
  function setBookmarks(list) {
    localStorage.setItem(KEY, JSON.stringify(list));
  }
  function refreshBookmarkUI() {
    const saved = getBookmarks().includes(postId);
    btn?.setAttribute('aria-pressed', String(saved));
    btn?.classList.toggle('!bg-brand-500', saved);
    btn?.classList.toggle('!text-white', saved);
    if (label) label.textContent = saved ? 'Saved' : 'Save post';
  }
  btn?.addEventListener('click', () => {
    const list = getBookmarks();
    const idx = list.indexOf(postId);
    if (idx >= 0) list.splice(idx, 1);
    else list.push(postId);
    setBookmarks(list);
    refreshBookmarkUI();
  });
  refreshBookmarkUI();

  // Copy-link buttons in the summary table
  document.querySelectorAll('.copy-link-btn').forEach((el) => {
    el.addEventListener('click', async () => {
      const value = el.getAttribute('data-copy-value');
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const original = el.textContent;
        el.textContent = 'Copied!';
        setTimeout(() => (el.textContent = original), 1500);
      } catch {
        // Clipboard API unavailable — fail silently, link is still clickable.
      }
    });
  });

  // Notice image lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  document.querySelectorAll('.notice-image-trigger').forEach((el) => {
    el.addEventListener('click', () => {
      const src = el.getAttribute('data-image');
      if (lightboxImg && src) lightboxImg.src = src;
      lightbox?.classList.remove('hidden');
      lightbox?.classList.add('flex');
    });
  });
  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
  }
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

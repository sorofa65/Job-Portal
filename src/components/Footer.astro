---
const year = new Date().getFullYear();
const links = [
  { label: 'Govt Jobs', href: '/category/govt-job/' },
  { label: 'Bank Jobs', href: '/category/bank-job/' },
  { label: 'Private Jobs', href: '/category/private-job/' },
  { label: 'Results', href: '/category/result/' },
  { label: 'Notice', href: '/category/notice/' },
  { label: 'Blog', href: '/blog/' },
];
const legalLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Disclaimer', href: '/disclaimer/' },
];
---

<footer class="mt-16 border-t border-ink/5 dark:border-paper/10 bg-white/60 dark:bg-ink-soft/60">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2 font-display text-lg font-bold text-ink dark:text-paper">
          <span class="flex h-8 w-8 items-center justify-center rounded-md bg-brand-gradient text-white text-sm">BD</span>
          <span>Job<span class="text-brand-500">Circular</span></span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-ink-muted dark:text-paper/50">
          Verified government, bank, and private job circulars — updated daily, published as it happens.
        </p>
      </div>

      <div>
        <h4 class="font-display text-sm font-semibold text-ink dark:text-paper">Information</h4>
        <ul class="mt-3 space-y-2 text-sm text-ink-muted dark:text-paper/50">
          {legalLinks.map((l) => <li><a href={l.href} class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors">{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="font-display text-sm font-semibold text-ink dark:text-paper">Browse</h4>
        <ul class="mt-3 space-y-2 text-sm text-ink-muted dark:text-paper/50">
          {links.map((l) => (
            <li><a href={l.href} class="hover:text-brand-600 dark:hover:text-brand-300 transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-display text-sm font-semibold text-ink dark:text-paper">Disclaimer</h4>
        <p class="mt-3 text-sm text-ink-muted dark:text-paper/50">
          Information is collected from official notices for convenience. Always verify details on the issuing organization's official website before applying.
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-ink/5 dark:border-paper/10 pt-6 text-xs text-ink-muted dark:text-paper/40 sm:flex-row">
      <p>© {year} BDJobPortal. All rights reserved.</p>
      <p>Built with Astro & Tailwind CSS.</p>
    </div>
  </div>
</footer>

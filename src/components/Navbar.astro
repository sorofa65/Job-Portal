---
const categories = [
  { label: 'Govt Jobs', href: '/category/govt-job/' },
  { label: 'Bank Jobs', href: '/category/bank-job/' },
  { label: 'Private Jobs', href: '/category/private-job/' },
  { label: 'Notice', href: '/category/notice/' },
  { label: 'Results', href: '/category/result/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="glass-nav sticky top-0 z-50">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold text-ink dark:text-paper">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-brand-gradient text-white text-sm">BD</span>
      <span>Job<span class="text-brand-500">Circular</span></span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {categories.map((c) => (
        <li>
          <a href={c.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-brand-500/10 hover:text-brand-600 dark:text-paper/70 dark:hover:text-brand-300 transition-colors">
            {c.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="search-trigger"
        type="button"
        aria-label="Search jobs"
        class="flex items-center gap-2 rounded-full border border-ink/10 dark:border-paper/15 bg-white/70 dark:bg-white/5 px-3 py-2 text-sm text-ink-muted dark:text-paper/60 hover:border-brand-400 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="hidden sm:inline">Search jobs…</span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-ink/10 dark:border-paper/15 hover:border-brand-400 transition-colors"
      >
        <svg id="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="block dark:hidden"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>

      <button
        id="drawer-toggle"
        type="button"
        aria-label="Open menu"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-ink/10 dark:border-paper/15 md:hidden"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div id="mobile-drawer" class="hidden md:hidden border-t border-ink/5 dark:border-paper/10 bg-paper dark:bg-ink">
    <ul class="flex flex-col p-2">
      {categories.map((c) => (
        <li>
          <a href={c.href} class="block rounded-md px-3 py-2.5 text-sm font-medium text-ink-muted hover:bg-brand-500/10 hover:text-brand-600 dark:text-paper/70">
            {c.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<!-- Live search overlay -->
<div id="search-overlay" class="fixed inset-0 z-[60] hidden">
  <div id="search-backdrop" class="absolute inset-0 bg-ink/50 backdrop-blur-sm"></div>
  <div class="relative mx-auto mt-24 w-[92%] max-w-xl rounded-xl2 bg-white dark:bg-ink-soft shadow-glass border border-ink/10 dark:border-paper/10">
    <div class="flex items-center gap-3 border-b border-ink/10 dark:border-paper/10 px-4 py-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-muted dark:text-paper/40"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search by title, category, or post name…"
        class="w-full bg-transparent py-2 text-sm text-ink dark:text-paper placeholder:text-ink-muted/60 focus:outline-none"
        autocomplete="off"
      />
      <kbd class="hidden sm:inline rounded border border-ink/15 dark:border-paper/20 px-1.5 py-0.5 text-[10px] font-mono text-ink-muted dark:text-paper/40">Esc</kbd>
    </div>
    <ul id="search-results" class="max-h-96 overflow-y-auto p-2"></ul>
    <p id="search-empty" class="hidden px-4 py-6 text-center text-sm text-ink-muted dark:text-paper/40">No jobs match your search.</p>
  </div>
</div>

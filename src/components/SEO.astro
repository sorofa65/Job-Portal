---
// SEO.astro — centralized <head> metadata. Pass `jobPosting` on post pages
// to emit Schema.org JobPosting JSON-LD for Google's job search rich results.
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string; // e.g. "/posts/tmed-job-circular-2026"
  jobPosting?: {
    title: string;
    description: string;
    datePosted: string;
    validThrough?: string;
    hiringOrganizationName: string;
    applyUrl?: string;
  } | null;
  schemas?: Record<string, unknown>[];
  keywords?: string;
  article?: boolean;
  robots?: string;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  canonicalPath = Astro.url.pathname,
  jobPosting = null,
  schemas = [],
  keywords,
  article = false,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props as Props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yakub.blog';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const absoluteImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const jobPostingSchema = jobPosting
  ? {
      '@context': 'https://schema.org/',
      '@type': 'JobPosting',
      title: jobPosting.title,
      description: jobPosting.description,
      datePosted: jobPosting.datePosted,
      validThrough: jobPosting.validThrough,
      employmentType: 'FULL_TIME',
      industry: 'Recruitment',
      applicantLocationRequirements: {
        '@type': 'Country',
        name: 'Bangladesh',
      },
      jobLocationType: 'ON_SITE',
      hiringOrganization: {
        '@type': 'Organization',
        name: jobPosting.hiringOrganizationName,
      },
      jobLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'BD',
        },
      },
      directApply: true,
      applicationContact: jobPosting.applyUrl
        ? { '@type': 'ContactPoint', url: jobPosting.applyUrl }
        : undefined,
    }
  : null;

const customSchemas = schemas.length ? schemas : [];
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content="Yakub Blog" />
<meta name="content-language" content="en, bn" />
<link rel="canonical" href={canonicalUrl} />

<!-- OpenGraph -->
<meta property="og:type" content={jobPosting || article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="BD Job Portal" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<meta name="robots" content={robots} />
<meta name="theme-color" content="#0b6e4f" />

{jobPostingSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(jobPostingSchema)} />
)}

{customSchemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

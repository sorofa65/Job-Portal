---
import DeadlineBadge from './DeadlineBadge.astro';
import { formatDate, getTotalVacancy, slugifyCategory } from '../utils/jobs.js';

interface Props {
  post: any;
}
const { post } = Astro.props as Props;
const vacancy = getTotalVacancy(post);
const org = post.summaryTable?.find((r: any) => /organization/i.test(r.label))?.value ?? '';
---

<a
  href={`/posts/${post.slug}/`}
  class="job-card group animate-fade-up"
  data-id={post.id}
  data-category={post.category}
  data-title={post.title.toLowerCase()}
  data-post-name={(post.summaryTable?.find((r: any) => /post name/i.test(r.label))?.value ?? '').toLowerCase()}
>
  <div class="relative aspect-[16/9] overflow-hidden rounded-t-xl2">
    <img
      src={post.image}
      alt={post.title}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/50 to-transparent"></div>
    <span class="absolute top-3 left-3 rounded-md bg-white/90 dark:bg-ink/80 px-2 py-1 text-[11px] font-mono font-semibold text-brand-700 dark:text-brand-300 shadow-sm">
      {post.category}
    </span>
    <span class="absolute top-3 right-3">
      <DeadlineBadge post={post} />
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2.5 p-4">
    {org && (
      <span class="text-xs font-mono font-medium text-brand-600 dark:text-brand-300 truncate">
        {org}
      </span>
    )}
    <h3 class="font-display text-base font-semibold leading-snug text-ink dark:text-paper line-clamp-2 group-hover:text-brand-600 dark:group-hover:text-brand-300 transition-colors">
      {post.title}
    </h3>

    <div class="mt-auto flex items-center justify-between pt-2 text-xs text-ink-muted dark:text-paper/50">
      <span class="font-mono">{formatDate(post.date)}</span>
      {vacancy && (
        <span class="rounded-full bg-brand-500/10 px-2 py-1 font-mono font-semibold text-brand-700 dark:text-brand-300">
          {vacancy} posts
        </span>
      )}
    </div>
  </div>
</a>

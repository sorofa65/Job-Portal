---
// AdSlot.astro — designated high-CPM ad placements.
// Drop your real AdSense / Adsterra snippets into the matching branch below.
// `variant` controls placement styling; `post` (optional) lets a slot react
// to per-post targeting flags like `targetVideoAd`.
interface Props {
  variant: 'header-banner' | 'in-content' | 'floating-sticky' | 'sidebar';
  post?: any;
  slotId?: string;
}
const { variant, post = null, slotId } = Astro.props as Props;

// Example of conditional ad targeting driven by JSON data:
// posts with `targetVideoAd: true` get a video-capable unit instead of
// a static banner in the in-content slot.
const useVideoUnit = variant === 'in-content' && post?.targetVideoAd === true;

const wrapperClass = {
  'header-banner': 'w-full flex justify-center py-2 bg-ink/[0.02] dark:bg-white/[0.02]',
  'in-content': 'w-full flex justify-center my-8',
  'floating-sticky': 'fixed bottom-0 left-0 right-0 z-40 md:hidden bg-paper/95 dark:bg-ink/95 backdrop-blur border-t border-ink/10 dark:border-paper/10',
  sidebar: 'w-full flex justify-center',
}[variant];

const dims = {
  'header-banner': { w: 728, h: 90, mobile: '320x50' },
  'in-content': { w: 336, h: 280, mobile: '300x250' },
  'floating-sticky': { w: 320, h: 50, mobile: '320x50' },
  sidebar: { w: 300, h: 600, mobile: '300x250' },
}[variant];
---

<div class={wrapperClass} data-ad-variant={variant} data-ad-slot={slotId}>
  <div
    class="ad-unit relative flex items-center justify-center rounded-lg border border-dashed border-ink/15 dark:border-paper/15 bg-ink/[0.02] dark:bg-white/[0.02] text-[11px] font-mono uppercase tracking-wide text-ink-muted dark:text-paper/40"
    style={`width:100%; max-width:${dims.w}px; height:${dims.h}px;`}
  >
    <!--
      Production integration:

      AdSense:
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-XXXXXXXXXXXX"
        data-ad-slot="XXXXXXXXXX" data-ad-format="auto" data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>

      Adsterra:
      <script type="text/javascript">
        atOptions = { key: 'YOUR_KEY', format: 'iframe', height: {dims.h}, width: {dims.w}, params: {} };
      </script>
      <script src={`//www.highperformanceformat.com/YOUR_KEY/invoke.js`}></script>

      {useVideoUnit ? 'Video ad unit goes here for targeted posts.' : ''}
    -->
    Ad {dims.w}×{dims.h} ({dims.mobile} mobile)
  </div>
  {variant === 'floating-sticky' && (
    <button
      class="absolute -top-3 right-2 h-6 w-6 rounded-full bg-ink/80 text-paper dark:bg-paper/80 dark:text-ink text-xs leading-none"
      aria-label="Close ad"
      onclick="this.closest('[data-ad-variant]').style.display='none'"
    >×</button>
  )}
</div>
